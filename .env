# Database-verbinding voor de PHP-app
#
# Platform:                    DB_HOST waarde:
# ──────────────────────────────────────────────
# Docker Compose (standaard):  db
# PHP lokaal op host (Linux/Windows): 127.0.0.1:4000
# Docker app-container via host (deze machine): host.docker.internal:4000
#
DB_HOST=db
DB_NAME=theater_aurora
DB_USER=root
DB_PASSWORD=rootpassword
APP_PORT=4001
